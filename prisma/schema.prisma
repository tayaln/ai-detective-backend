generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  runtime             = "nodejs"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Better Auth models, generated by `npx auth generate`. Two deliberate,
// approved additions, both kept when the CLI is run again:
//   - @db.Timestamptz(3) on every DateTime, because all timestamps are
//     timestamptz and Better Auth's generator cannot emit native types.
//   - Back-relation fields on User, which Prisma requires for the
//     application models' cascading foreign keys. They add no columns.
// Change nothing else here by hand; change Better Auth's config instead.
// ---------------------------------------------------------------------------

model User {
  id              String                 @id
  name            String
  email           String
  emailVerified   Boolean                @default(false)
  image           String?
  createdAt       DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime               @updatedAt @db.Timestamptz(3)
  sessions        Session[]
  accounts        Account[]
  // Back-relations to the application models; no columns on the user table.
  profile         Profile?
  stepCompletions CourseStepCompletion[]
  coursePositions CoursePosition[]
  attempts        Attempt[]
  feedback        Feedback[]
  saralMessages   SaralMessage[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime @db.Timestamptz(3)
  token     String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
  @@map("verification")
}

// ---------------------------------------------------------------------------
// Application models. Every learner reference is String, matching user.id,
// and cascades so deleting a learner deletes all of their data.
// ---------------------------------------------------------------------------

model Profile {
  learnerId     String    @id @map("learner_id")
  // A copy of user.email so profiles read on their own in a database client.
  // The user table stays the source; every profile write copies it across.
  email         String
  detectiveName String?   @map("detective_name")
  avatarId      String?   @map("avatar_id")
  soundOn       Boolean   @default(true) @map("sound_on")
  lastSeenAt    DateTime? @map("last_seen_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  learner       User      @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

// One row per step the learner has moved forward from. The row's existence is
// the fact that the step is complete; there is no row for a step only opened.
// Position and mission state are derived from these rows, never stored.
model CourseStepCompletion {
  learnerId   String   @map("learner_id")
  courseId    String   @map("course_id")
  stepId      String   @map("step_id")
  completedAt DateTime @default(now()) @map("completed_at") @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  learner     User     @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  @@id([learnerId, courseId, stepId])
  @@map("course_step_completions")
}

// The last step the learner moved on from in each mission, overwritten on every
// move (completions are set once, so they cannot say where a replay got to). Only
// used to resume a mission the learner has already finished.
model CoursePosition {
  learnerId String   @map("learner_id")
  courseId  String   @map("course_id")
  stepId    String   @map("step_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  learner   User     @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  @@id([learnerId, courseId])
  @@map("course_positions")
}

model Attempt {
  id              BigInt    @id @default(autoincrement())
  learnerId       String    @map("learner_id")
  courseId        String    @map("course_id")
  stepId          String    @map("step_id")
  stepType        String    @map("step_type")
  attemptNumber   Int       @map("attempt_number") @db.SmallInt
  submittedAnswer String    @map("submitted_answer")
  isCorrect       Boolean   @map("is_correct")
  score           Int?      @db.SmallInt
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  syncedAt        DateTime? @map("synced_at") @db.Timestamptz(3)
  learner         User      @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  // attempt_number is computed server-side; this stops two concurrent
  // submissions from both claiming the same number.
  @@unique([learnerId, courseId, stepId, attemptNumber])
  @@map("attempts")
}

model Feedback {
  id        BigInt    @id @default(autoincrement())
  learnerId String    @map("learner_id")
  courseId  String    @map("course_id")
  stepId    String    @map("step_id")
  message   String
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  emailedAt DateTime? @map("emailed_at") @db.Timestamptz(3)
  learner   User      @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  @@index([learnerId])
  @@map("feedback")
}

model SaralMessage {
  id             BigInt   @id @default(autoincrement())
  learnerId      String   @map("learner_id")
  courseId       String   @map("course_id")
  stepId         String   @map("step_id")
  role           String
  content        String
  inputTokens    Int?     @map("input_tokens")
  outputTokens   Int?     @map("output_tokens")
  cachedTokens   Int?     @map("cached_tokens")
  // Billed as output but not part of output_tokens.
  thinkingTokens Int?     @map("thinking_tokens")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  learner        User     @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  // Per-learner usage limits count recent messages.
  @@index([learnerId, createdAt])
  @@map("saral_messages")
}

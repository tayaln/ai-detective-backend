# Copy to .env and fill in locally. Names only — never commit a value here.

# Runtime
NODE_ENV=
PORT=
# Comma-separated origins allowed cross-origin (dev and review frontends)
CORS_ORIGINS=

# Database
DATABASE_URL=

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Email — EMAIL_MODE is "console" unless explicitly set to "live"
EMAIL_MODE=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
BREVO_DAILY_CAP=
FEEDBACK_RECIPIENT_EMAIL=

# AI mentor (Saral)
AI_PROVIDER_API_KEY=
AI_MODEL=

# Content
CONTENT_BUNDLE_PATH=

# Google Sheets export
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=

# Logging
LOG_LEVEL=
LOG_DIR=

# Copy to .env and fill in locally. Names only — never commit a value here.

# Runtime
NODE_ENV=
PORT=
# Comma-separated origins allowed cross-origin (dev and review frontends)
CORS_ORIGINS=

# Database
DATABASE_URL=

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Email — EMAIL_MODE is "console" unless explicitly set to "live"
EMAIL_MODE=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
BREVO_DAILY_CAP=
FEEDBACK_RECIPIENT_EMAIL=

# AI mentor (Saral) — Google Gemini REST API
AI_PROVIDER_API_KEY=
AI_MODEL=
# Directory holding one <courseId>/saral-block.json per mission.
SARAL_BLOCK_PATH=
# Path to the personality text file shared by every mission.
SARAL_PERSONALITY_PATH=
# Per-learner daily message limit (default 20). This is the AI spend ceiling.
SARAL_DAILY_LIMIT=
# Max prior messages replayed into each model call (default 50).
SARAL_HISTORY_CAP=

# Content
# Directory with one <courseId>/course-bundle.json per mission (frontend build
# output). Locally, ../ai-detective-frontend/content/courses also works.
CONTENT_BUNDLE_PATH=

# Google Sheet attempt log — written through an Apps Script web app.
# GOOGLE_SCRIPT_URL is a credential (it includes the shared key); .env only.
GOOGLE_SCRIPT_URL=
GOOGLE_SHEET_URL=

# Logging
LOG_LEVEL=
LOG_DIR=
